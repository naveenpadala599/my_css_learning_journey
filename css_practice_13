<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Z-Index Lab</title>

<style>

.stage {
  border: 4px solid black;
  width: 500px;
  height: 350px;
  margin: 40px;
  position: relative;
  z-index: 2;
}

.box {
  width: 180px;
  height: 180px;
  position: absolute;
  color: white;
  font-size: 24px;
  font-weight: bold;

  display: flex;
  justify-content: center;
  align-items: center;
}

.red {
  background: red;
  top: 40px;
  left: 40px;
  z-index: 1;
}

.blue {
  background: blue;
  top: 100px;
  left: 120px;
  z-index: 2;
}

.green {
  background: green;
  top: 160px;
  left: 200px;
  z-index: 3;
}
.outside-box {
  width: 220px;
  height: 220px;
  background: purple;
  color: white;
  font-size: 24px;
  font-weight: bold;

  position: relative;
  top: -260px;
  left: 250px;

  z-index: 1;
}

</style>
</head>

<body>

<h1>Z-Index Lab</h1>

<div class="stage">
  <div class="box red">Red</div>
  <div class="box blue">Blue</div>
  <div class="box green">Green</div>
</div>
<div class="outside-box">Outside Box</div>

</body>
</html>
