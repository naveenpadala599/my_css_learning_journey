<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Responsive Design Lab</title>

  <style>
    *{
     box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f4f4;
    }

    .page {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px;
      border: 4px solid black;
      background: white;
    }

    .hero {
      background: lightblue;
      padding: 40px;
      text-align: center;
      margin-bottom: 20px;
    }

    .layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
    }

    .main {
      background: lightgreen;
      padding: 20px;
    }

    .sidebar {
      background: lightcoral;
      padding: 20px;
    }

    .cards {
      display: flex;
      gap: 20px;
      margin-top: 20px;
    }

    .card {
      background: khaki;
      padding: 20px;
      flex: 1;
      border: 2px solid black;
    }
    @media (max-width: 700px){
      body{
      background: red;
    }
      .page{
      background: red;
      padding: 10px;
    }
      .layout{
      grid-template-columns: 1fr;
    }
      .cards{
      flex-direction: column;
    }
      .hero{
      padding: 20px;
      background: blue;
      color: red;
    }
      .hero h1{
      font-size: 24px;
    }
    }
   
  </style>
</head>

<body>

  <div class="page">

    <section class="hero">
      <h1>Responsive Design Lab</h1>
      <p>This page is intentionally NOT responsive yet.</p>
    </section>

    <section class="layout">

      <main class="main">
        <h2>Main Content</h2>
        <p>
          On small screens, this layout will break until we fix it using responsive CSS.
        </p>

        <div class="cards">
          <div class="card">Card 1</div>
          <div class="card">Card 2</div>
          <div class="card">Card 3</div>
        </div>
      </main>

      <aside class="sidebar">
        <h2>Sidebar</h2>
        <p>This sidebar is beside the main content right now.</p>
      </aside>

    </section>

  </div>
<img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800" alt="Mountain landscape"></body>
  </html>
